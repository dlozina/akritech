{
  "name": "akritech",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build-stats": "cross-env ANALYZE=true next build --webpack",
    "build-prod": "npm run clean && npm run check && npm run build && npm run test:seo",
    "clean": "rimraf .next out",
    "lint": "eslint . --max-warnings=0",
    "build-types": "tsc --noEmit --pretty",
    "check": "npm run lint && npm run build-types",
    "test:seo": "node --test tests/seo.test.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/bundle-analyzer": "16.4.3",
    "@next/eslint-plugin-next": "16.4.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "license": "ISC",
  "private": true,
  "engines": {
    "node": "24.x"
  }
}
